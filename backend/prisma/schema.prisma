// Prisma schema para o SaaS de RH. Configurado para Vercel Postgres.
// Ajuste a variável de ambiente DATABASE_URL com a conexão do Vercel Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id             String      @id @default(uuid())
  cnpj           String      @unique @db.VarChar(18)
  nome           String
  nomeFantasia   String?
  ramoAtividade  String?
  createdAt      DateTime    @default(now())
  funcionarios   Funcionario[]
  beneficios     Beneficio[]
  reportsAnonimos ReportAnonimo[]
  despesas       Despesa[]
}

model Funcionario {
  id               String            @id @default(uuid())
  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId        String
  nome             String
  cpf              String            @unique @db.VarChar(14)
  dataAdmissao     DateTime          @db.Date
  cargo            String
  salarioBase      Decimal           @db.Decimal(12, 2)
  status           StatusFuncionario @default(ativo)
  jornadaSemanal   Decimal?          @db.Decimal(4, 2)
  emailCorporativo String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  beneficios       FuncionarioBeneficio[]
  folhas           FolhaPagamento[]
  rescisoes        Rescisao[]
  pontos           Ponto[]
  atestados        AtestadoAfastamento[]
}

model Beneficio {
  id          String                 @id @default(uuid())
  empresa     Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId   String
  tipo        TipoBeneficio
  nomeCustom  String?
  valor       Decimal                @db.Decimal(12, 2)
  descricao   String?
  createdAt   DateTime               @default(now())
  funcionarios FuncionarioBeneficio[]
}

model FuncionarioBeneficio {
  id            String       @id @default(uuid())
  funcionario   Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String
  beneficio     Beneficio    @relation(fields: [beneficioId], references: [id], onDelete: Cascade)
  beneficioId   String
  concedidoEm   DateTime     @default(now())

  @@unique([funcionarioId, beneficioId])
}

model FolhaPagamento {
  id              String       @id @default(uuid())
  funcionario     Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId   String
  mesAno          DateTime     @db.Date
  salario         Decimal      @db.Decimal(12, 2)
  fgts            Decimal      @db.Decimal(12, 2)
  inss            Decimal      @db.Decimal(12, 2)
  decimoTerceiro  Decimal?     @db.Decimal(12, 2)
  ferias          Decimal?     @db.Decimal(12, 2)
  adiantamento    Decimal?     @db.Decimal(12, 2)
  insalubridade   Decimal?     @db.Decimal(12, 2)
  periculosidade  Decimal?     @db.Decimal(12, 2)
  outrosCreditos  Decimal?     @db.Decimal(12, 2)
  outrosDescontos Decimal?     @db.Decimal(12, 2)
  totalPago       Decimal      @db.Decimal(12, 2)
  jsonEsocial     Json?
  createdAt       DateTime     @default(now())

  @@unique([funcionarioId, mesAno])
}

model Rescisao {
  id             String       @id @default(uuid())
  funcionario    Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId  String
  dataDemissao   DateTime     @db.Date
  tipo           TipoRescisao
  valorTotal     Decimal      @db.Decimal(12, 2)
  detalhes       Json?
  createdAt      DateTime     @default(now())
}

model Ponto {
  id             String       @id @default(uuid())
  funcionario    Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId  String
  dataHora       DateTime     @db.Timestamptz(6)
  tipo           TipoPonto
  latitude       Float?
  longitude      Float?
  metodo         MetodoPonto
  imagemProvaUrl String?
  createdAt      DateTime     @default(now())
}

model ReportAnonimo {
  id         String      @id @default(uuid())
  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId  String
  conteudo   String
  tipo       String
  status     StatusReport @default(pendente)
  createdAt  DateTime     @default(now())
}

model AtestadoAfastamento {
  id            String       @id @default(uuid())
  funcionario   Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String
  tipo          TipoAfastamento
  dataInicio    DateTime     @db.Date
  dataFim       DateTime     @db.Date
  motivo        String?
  arquivoUrl    String
  createdAt     DateTime     @default(now())
}

model Despesa {
  id             String      @id @default(uuid())
  empresa        Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId      String
  descricao      String
  valor          Decimal     @db.Decimal(12, 2)
  data           DateTime    @db.Date
  categoria      String?
  statusAprovacao StatusAprovacaoDespesa @default(pendente)
  createdAt      DateTime    @default(now())
}

enum StatusFuncionario {
  ativo
  afastado
  demitido
}

enum TipoBeneficio {
  alimentacao
  refeicao
  mobilidade
  saude
  educacao
  cultura
  home_office
  premiacao
  custom
}

enum TipoRescisao {
  com_justa_causa
  sem_justa_causa
}

enum TipoPonto {
  entrada
  saida
}

enum MetodoPonto {
  facial
  manual
}

enum StatusReport {
  pendente
  resolvido
}

enum TipoAfastamento {
  atestado
  afastamento
}

enum StatusAprovacaoDespesa {
  pendente
  aprovado
  rejeitado
}
